cmake_minimum_required(VERSION 3.17)

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED BINARY_DIR)
	message(FATAL_ERROR "SOURCE_DIR and BINARY_DIR are required")
endif()

set(CMAKE_CURRENT_SOURCE_DIR "${SOURCE_DIR}")
set(CMAKE_INSTALL_PREFIX "${BINARY_DIR}/prefix")
set(ENABLE_INSTALL OFF)
set(VERSION "0.0.0")
set(failures "")

function(check_libdir name install_libdir expected)
	set(CMAKE_CURRENT_BINARY_DIR "${BINARY_DIR}/${name}")
	set(CMAKE_INSTALL_LIBDIR "${install_libdir}")
	include("${SOURCE_DIR}/build/cmake/CreatePkgConfigFile.cmake")
	file(READ "${CMAKE_CURRENT_BINARY_DIR}/build/pkgconfig/libarchive.pc" contents)
	string(REGEX MATCH "\nlibdir=([^\n]*)\n" match "${contents}")
	if(NOT CMAKE_MATCH_1 STREQUAL expected)
		message(STATUS "${name}: expected '${expected}', got '${CMAKE_MATCH_1}'")
		list(APPEND failures "${name}")
		set(failures "${failures}" PARENT_SCOPE)
	endif()
endfunction()

check_libdir(default "lib" "\${exec_prefix}/lib")
check_libdir(lib64 "lib64" "\${exec_prefix}/lib64")
check_libdir(relative "custom/lib" "\${exec_prefix}/custom/lib")
check_libdir(absolute "${BINARY_DIR}/absolute/lib" "${BINARY_DIR}/absolute/lib")
check_libdir(spaces "${BINARY_DIR}/absolute library" "${BINARY_DIR}/absolute library")

if(failures)
	message(FATAL_ERROR "Incorrect pkg-config library directories: ${failures}")
endif()
